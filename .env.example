# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# LLM Model (must be pulled in Ollama first: ollama pull mistral)
LLM_MODEL=mistral

# Embedding Model (must be pulled in Ollama first: ollama pull nomic-embed-text)
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# Upload directory for documents
UPLOAD_DIR=./uploaded_docs

# Chunk size and overlap for document splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Number of retrieved chunks for context
RETRIEVAL_TOP_K=4

# Server
HOST=0.0.0.0
PORT=8000
